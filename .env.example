# Delta Exchange Configuration
EXCHANGE_ENV=india
# Options: https://api.india.delta.exchange or https://api.delta.exchange
DELTA_BASE_URL=https://api.india.delta.exchange

# Market Parameters
SYMBOL=ETHUSD
TIMEFRAME=5m
UNDERLYING_ASSET=ETH

# Supertrend Parameters
SUPERTREND_PERIOD=10
SUPERTREND_MULTIPLIER=3.0

# CVD Parameters
CVD_LOOKBACK=50
CVD_EMA_PERIOD=10

# Volatility & Trend Filters (Suggestions)
ADX_PERIOD=14
ADX_TREND_THRESHOLD=22.0
VOL_HIGH_PERCENTILE=60.0
VOL_LOW_PERCENTILE=35.0

# Option Expiry Selection (nearest, weekly, monthly)
EXPIRY_PREFERENCE=nearest
MIN_DTE_HOURS=2.0

# Messaging Integrations (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
